{
  "name": "treg",
  "version": "0.1.0",
  "private": true,
  "description": "ffmpeg wrapper with a customizable progress display and readable error messages. A TypeScript port of ffpb.",
  "type": "module",
  "bin": {
    "treg": "dist/treg.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx bin/treg.ts",
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "tsx scripts/capture-fixtures.ts"
  },
  "keywords": [
    "ffmpeg",
    "progress",
    "cli"
  ],
  "author": "Richard Kichenama",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
