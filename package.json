{
  "name": "treg",
  "version": "0.1.0",
  "private": true,
  "description": "ffmpeg wrapper with a customizable progress display and readable error messages. A TypeScript port of ffpb.",
  "type": "module",
  "bin": {
    "treg": "dist/treg.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx bin/treg.ts",
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ffmpeg",
    "progress",
    "cli"
  ],
  "author": "Richard Kichenama",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
